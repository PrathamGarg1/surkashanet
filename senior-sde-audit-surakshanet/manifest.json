{
  "manifest_version": 3,
  "name": "SurakshaNet",
  "version": "2.0.0",
  "description": "On-device WhatsApp Web abuse detection. Raw chat never leaves the browser.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SurakshaNet"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "assets/models/*",
        "assets/models/custom-macd-model/*",
        "assets/models/custom-macd-model/onnx/*"
      ],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
